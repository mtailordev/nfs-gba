<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher asks for the player's ROM once (the system file picker) and copies it into the app's files; the game
     activity runs the native library. Nothing of the game ships in the app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="NFS Carbon GBA (unofficial)"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="nfsgba" />
        </activity>
    </application>

</manifest>
